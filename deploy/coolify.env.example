POSTGRES_DB=zara
POSTGRES_USER=zara
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://zara:replace-with-a-long-random-database-password@postgres:5432/zara
COMPOSE_PARALLEL_LIMIT=1

REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_MAXMEMORY=256mb
PSTN_ADMISSION_REDIS_URL=redis://default:replace-with-a-url-encoded-redis-password@redis:6379
PSTN_ADMISSION_GLOBAL_MAX_CONCURRENT_CALLS=20
PSTN_ADMISSION_GLOBAL_CPS_RATE=10
PSTN_ADMISSION_GLOBAL_CPS_BURST=10
PSTN_ADMISSION_PROVIDER_CPS_RATE=5
PSTN_ADMISSION_PROVIDER_CPS_BURST=5
PSTN_ADMISSION_TWILIO_QUOTA_MAX_CONCURRENT_CALLS=20
PSTN_ADMISSION_PREMIUM_MAX_CONCURRENT_CALLS=20
PSTN_ADMISSION_WORKER_MAX_CONCURRENT_CALLS=20
REALTIME_WORKER_PUBLIC_URL=wss://realtime.example.com/telephony/twilio/media-streams
PSTN_WORKER_ID=pstn-worker-1
PSTN_WORKER_RELEASE_ID=replace-with-release-id
PSTN_WORKER_HEARTBEAT_INTERVAL_MS=5000
PSTN_WORKER_HEARTBEAT_TTL_MS=15000
PSTN_WORKER_DRAIN_TIMEOUT_MS=1800000
PSTN_WORKER_MAX_CALLS=20
PSTN_WORKER_MAX_CPU_PERCENT=85
PSTN_WORKER_MAX_MEMORY_PERCENT=85
PSTN_WORKER_MAX_MEMORY_BYTES=1073741824
PSTN_WORKER_MAX_EVENT_LOOP_LAG_MS=50
PSTN_INSTANCE_CPU_LIMIT_MILLICORES=1000
PGPOOL_MAX=10
PSTN_WORKER_MAX_OPEN_FILE_DESCRIPTORS=4096
PSTN_WORKER_MAX_WEBSOCKETS=200
MINIO_ROOT_USER=zara-minio-root
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-root-password
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=zara-minio-root
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-a-long-random-minio-root-password
OBJECT_STORAGE_FORCE_PATH_STYLE=true
RECORDINGS_BUCKET=zara-recordings
ASSETS_BUCKET=zara-assets

API_PUBLIC_URL=https://api.example.com
APP_PUBLIC_URL=https://app.example.com
ADMIN_PUBLIC_URL=https://admin.example.com
ZARA_TRUSTED_ORIGINS=https://app.example.com,https://admin.example.com

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ZARA_AUTH_EMAIL_WEBHOOK_URL=https://email.example.com/zara/auth
ZARA_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
ZARA_AUTH_RATE_LIMIT_MAX=300
ZARA_AUTH_RESET_TOKEN_TTL_SECONDS=3600
ZARA_AUTH_VERIFICATION_TOKEN_TTL_SECONDS=3600
ZARA_PLATFORM_STAFF_ROLES=admin@example.com=platform_owner,support@example.com=platform_support
SANDBOX_TRANSPORT_TOKEN_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
GEMINI_API_KEY=
# Direct provider billing evidence. Do not use Zara-defined report URLs.
CARTESIA_ADMIN_API_KEY=
OPENAI_ADMIN_KEY=
